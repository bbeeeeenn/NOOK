generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PatronType {
  Visitor
  Student
  Faculty
  Graduate
}

model BorrowLog {
  id String @id @default(cuid())

  type        PatronType
  date        DateTime   @default(now())
  scannedId   String?
  idNumber    String?
  bookBarcode String
  bookTitle   String?
  bookAuthor  String?

  borrower BorrowerRecord? @relation(fields: [idNumber], references: [idNumber])

  @@index([date])
  @@index([type])
  @@index([idNumber, date])
}

model BorrowerRecord {
  idNumber   String   @id
  firstname  String
  lastname   String
  middlename String?
  yearLevel  Int
  program    String
  college    String
  createdAt  DateTime @default(now())

  borrowLogs BorrowLog[]

  @@index([createdAt])
}

enum UserType {
  Admin
  Staff
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  userType      UserType  @default(Staff)

  accounts      Account[]
  sessions      Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Below are for authentication purposes
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
