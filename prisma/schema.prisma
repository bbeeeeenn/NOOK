generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminAccount {
  id       String @id @default(cuid())
  name     String
  username String @unique
  email    String @unique
  password String

  configuration Configuration?
}

model Configuration {
  id            String @id @default(cuid())
  spreadsheetId String

  adminAccountId String       @unique
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id])
}

model BorrowLog {
  id String @id @default(cuid())

  date        DateTime @default(now())
  idNumber    String
  bookBarcode String
  bookTitle   String?
  bookAuthor  String?

  borrower Borrower @relation(fields: [idNumber], references: [idNumber])

  @@index([date])
  @@index([idNumber, date])
}

model PendingBorrowLog {
  id String @id @default(cuid())

  date        DateTime @default(now())
  idNumber    String
  bookBarcode String
  bookTitle   String?
  bookAuthor  String?
  tableRange  String?

  @@index([date])
  @@index([idNumber, date])
}

model Borrower {
  id String @id @default(cuid())

  idNumber  String   @unique
  name      String
  yearLevel Int
  program   String
  college   String
  createdAt DateTime @default(now())

  borrowLogs BorrowLog[]

  @@index([createdAt])
}
